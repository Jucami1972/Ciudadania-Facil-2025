# Backend Environment Configuration
# Copia este archivo a .env y configura las variables

# Node environment (development | production)
NODE_ENV=development

# Server port
PORT=3000

# OpenAI API Key (requerida para transcripción y TTS)
# Obtén tu API key en: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-...

# RevenueCat Secret Key (requerida para validación server-side de compras)
# Obtén tu secret key en: https://app.revenuecat.com/settings/keys
REVENUECAT_SECRET_KEY=sk_...

# CORS: Orígenes permitidos (solo en producción)
# Separa múltiples orígenes con comas
# En desarrollo, CORS permite cualquier origen automáticamente
# Ejemplo: ALLOWED_ORIGINS=https://tu-app.com,https://api.tu-app.com
ALLOWED_ORIGINS=
